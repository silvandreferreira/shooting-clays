{
  "name": "@shooting-clays/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && pnpm build:vite",
    "build:vite": "vite build && vite build --ssr src/site/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:smoke": "playwright test -c playwright.smoke.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@sentry/react": "11.8.0",
    "@shooting-clays/shared": "workspace:*",
    "@tanstack/query-async-storage-persister": "5.104.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-persist-client": "5.104.5",
    "better-auth": "1.7.12",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "8.5.0",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0"
  }
}
