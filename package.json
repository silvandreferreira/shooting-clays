{
  "name": "shooting-clays",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "if git rev-parse --git-dir > /dev/null 2>&1; then lefthook install; fi",
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm --filter @shooting-clays/api dev\" \"pnpm --filter @shooting-clays/web dev\"",
    "dev:host": "concurrently -k -n api,web -c blue,magenta \"pnpm --filter @shooting-clays/api dev\" \"pnpm --filter @shooting-clays/web dev --host\"",
    "build": "pnpm -r build && node scripts/build-vercel.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @shooting-clays/web test:e2e",
    "test:e2e:ui": "pnpm --filter @shooting-clays/web test:e2e:ui",
    "test:e2e:report": "pnpm --filter @shooting-clays/web test:e2e:report",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:all": "pnpm check && pnpm build && pnpm test:e2e",
    "db:generate": "pnpm --filter @shooting-clays/api db:generate",
    "db:migrate": "pnpm --filter @shooting-clays/api db:migrate",
    "db:import": "pnpm --filter @shooting-clays/api db:import",
    "db:assign-owner": "pnpm --filter @shooting-clays/api db:assign-owner"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
