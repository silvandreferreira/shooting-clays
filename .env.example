# Copy to .env and fill in. Never commit .env.

# Neon connection string (local: dev branch)
DATABASE_URL=

# Observability (optional locally: without a token, logs go to the console)
LOGS_SOURCE_TOKEN=
# Only if your Better Stack source shows a different ingesting host
LOGS_INGEST_URL=
SENTRY_DSN=
VITE_SENTRY_DSN=

# Comma-separated admin emails (iteration 2+). Never commit real values.
ADMIN_EMAILS=
